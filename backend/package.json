{
  "name": "@lazy-janes/backend",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "test": "env -u DATABASE_URL -u PIN_PEPPER NODE_ENV=test vitest run",
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "db:seed:menu": "node --env-file=.env --import tsx src/db/seedMenu.ts",
    "db:sync:menu": "node --env-file=.env --import tsx src/db/syncMenuData.ts",
    "db:migrate:test": "env -u DATABASE_URL -u PIN_PEPPER NODE_ENV=test node --import tsx src/db/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "private": true,
  "dependencies": {
    "@lazy-janes/shared": "0.1.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
